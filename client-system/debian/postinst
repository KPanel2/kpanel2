#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR=/opt/kpanel-client
STATE_DIR=/var/lib/kpanel-client
SERVICE_NAME=kpanel-client.service
LAUNCHER_NAME=kpanel-client-launcher.sh
MODE_HELPER_NAME=kpanel-set-mode
DEFAULTS_DIR=/etc/default

is_pi_appliance() {
	[[ -x /usr/local/sbin/kpanel-pi-self-heal ]] || [[ -f /etc/profile.d/kpanel-startx.sh ]]
}

resolve_runtime_owner() {
	local service_user=""

	if [[ -f "/usr/share/kpanel-client/systemd/$SERVICE_NAME" ]]; then
		service_user="$(sed -n 's/^User=//p' "/usr/share/kpanel-client/systemd/$SERVICE_NAME" | head -n 1)"
	fi

	for candidate in "$service_user" pi kpanel; do
		if [[ -n "$candidate" ]] && id -u "$candidate" >/dev/null 2>&1; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done

	printf '%s\n' root
}

fix_runtime_home_permissions() {
	local home_dir=""

	home_dir="$(getent passwd "$RUNTIME_OWNER" | cut -d: -f6 || true)"
	if [[ -z "$home_dir" || ! -e "$home_dir" ]]; then
		return 0
	fi

	chown -R "$RUNTIME_OWNER:$RUNTIME_OWNER" "$home_dir"
	install -d -m 700 -o "$RUNTIME_OWNER" -g "$RUNTIME_OWNER" "$home_dir/.cache"
}

ensure_openbox_xdg_deps() {
	if ! dpkg -s python3-xdg >/dev/null 2>&1; then
		apt-get install -y python3-xdg || true
	fi
}

configure_client_service() {
	systemctl daemon-reload
	if is_pi_appliance; then
		systemctl disable "$SERVICE_NAME" --now 2>/dev/null || true
		if [[ -x /usr/local/sbin/kpanel-pi-self-heal ]]; then
			/usr/local/sbin/kpanel-pi-self-heal || true
		fi
		return 0
	fi

	systemctl enable "$SERVICE_NAME"
	systemctl restart "$SERVICE_NAME"
}

mkdir -p "$INSTALL_DIR"
cp -r /usr/share/kpanel-client/kpanel_client /usr/share/kpanel-client/requirements.txt "$INSTALL_DIR/"

python3 -m venv "$INSTALL_DIR/.venv"
export PYTHONPATH="$INSTALL_DIR${PYTHONPATH:+:$PYTHONPATH}"
"$INSTALL_DIR/.venv/bin/pip" install --upgrade pip
"$INSTALL_DIR/.venv/bin/pip" install -r "$INSTALL_DIR/requirements.txt"

cp /usr/share/kpanel-client/systemd/$SERVICE_NAME /etc/systemd/system/$SERVICE_NAME
cp /usr/share/kpanel-client/bin/$LAUNCHER_NAME /usr/local/bin/$LAUNCHER_NAME
chmod 755 /usr/local/bin/$LAUNCHER_NAME
for _helper in kpanel-configure-apt-repo kpanel-set-mode kpanel-show-mode kpanel-version kpanel-install-version kpanel-prod kpanel-stage kpanel-dev; do
	if [[ -f "/usr/share/kpanel-client/bin/$_helper" ]]; then
		cp "/usr/share/kpanel-client/bin/$_helper" "/usr/local/bin/$_helper"
		chmod 755 "/usr/local/bin/$_helper"
	fi
done
mkdir -p "$STATE_DIR"
RUNTIME_OWNER="$(resolve_runtime_owner)"
chown -R "$RUNTIME_OWNER:$RUNTIME_OWNER" "$INSTALL_DIR" "$STATE_DIR"
mkdir -p "$DEFAULTS_DIR"
if [ ! -f "$DEFAULTS_DIR/kpanel-client" ]; then
	cp /usr/share/kpanel-client/defaults/kpanel-client "$DEFAULTS_DIR/kpanel-client"
fi

if [[ "${KPANEL_SKIP_APT_REPO:-}" != "1" ]]; then
	if ! /usr/local/bin/kpanel-configure-apt-repo; then
		echo "Warning: failed to configure the KumpeApps apt repository; apt-based client updates may be unavailable until the repo is added manually." >&2
	fi
fi

ensure_openbox_xdg_deps
fix_runtime_home_permissions

# Grant the runtime user permission for timezone, remote reboot, and package updates.
install_runtime_sudoers() {
	local owner="$1"
	local sudoers_file="/etc/sudoers.d/kpanel-client"
	local sudoers_tmp="${sudoers_file}.tmp"
	local systemctl_path
	systemctl_path="$(command -v systemctl || true)"

	cat >"$sudoers_tmp" <<EOF
${owner} ALL=(root) NOPASSWD: /usr/bin/timedatectl set-timezone *
EOF
	if [[ -n "$systemctl_path" ]]; then
		printf '%s ALL=(root) NOPASSWD: %s reboot\n' "$owner" "$systemctl_path" >>"$sudoers_tmp"
	fi
	cat >>"$sudoers_tmp" <<EOF
${owner} ALL=(root) NOPASSWD: /usr/bin/apt-get update
${owner} ALL=(root) NOPASSWD: /usr/bin/apt-get install *
${owner} ALL=(root) NOPASSWD: /usr/bin/dpkg *
EOF
	chmod 440 "$sudoers_tmp"
	if visudo -c -f "$sudoers_tmp" >/dev/null 2>&1; then
		rm -f /etc/sudoers.d/kpanel-timedatectl
		mv "$sudoers_tmp" "$sudoers_file"
	else
		rm -f "$sudoers_tmp"
		echo "Warning: sudoers rule validation failed; remote reboot/update and timezone changes may not apply." >&2
	fi
}

install_runtime_sudoers "$RUNTIME_OWNER"

configure_client_service
